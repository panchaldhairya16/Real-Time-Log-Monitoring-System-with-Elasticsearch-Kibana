# Copy to .env :  cp .env.example .env
# ---- Docker stack ----
STACK_VERSION=8.19.18        # Elasticsearch and Kibana MUST use the same version
ES_PORT=9200
KIBANA_PORT=5601
ES_HEAP=512m                 # raise to 1g if your machine has >= 8 GB RAM
KIBANA_ENCRYPTION_KEY=change-me-demo-key-0123456789abcdef   # >= 32 chars

# ---- Python apps ----
ES_URL=http://localhost:9200
ES_INDEX=application-logs
# Leave blank while security is disabled. Fill in if you enable security.
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=

LOG_FILE=logs/app.jsonl
SHIP_BATCH_SIZE=200
SHIP_FLUSH_SECONDS=2
SHIP_MAX_RETRIES=5
