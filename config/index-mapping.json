{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "@timestamp": { "type": "date" },
      "message": { "type": "text" },
      "log": {
        "properties": {
          "level": { "type": "keyword" }
        }
      },
      "service": {
        "properties": {
          "name": { "type": "keyword" }
        }
      },
      "host": {
        "properties": {
          "name": { "type": "keyword" }
        }
      },
      "http": {
        "properties": {
          "request": {
            "properties": {
              "method": { "type": "keyword" }
            }
          },
          "response": {
            "properties": {
              "status_code": { "type": "integer" }
            }
          }
        }
      },
      "url": {
        "properties": {
          "path": { "type": "keyword" }
        }
      },
      "event": {
        "properties": {
          "id": { "type": "keyword" },
          "duration": { "type": "long" }
        }
      },
      "source": {
        "properties": {
          "ip": { "type": "ip" }
        }
      },
      "error": {
        "properties": {
          "type": { "type": "keyword" }
        }
      },
      "user": {
        "properties": {
          "name": { "type": "keyword" }
        }
      }
    }
  }
}
